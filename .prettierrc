{
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "none",
  "printWidth": 100,
  "bracketSpacing": true,
  "endOfLine": "lf",
  "arrowParens": "always",
  "vueIndentScriptAndStyle": false,
  "htmlWhitespaceSensitivity": "css",
  "proseWrap": "preserve",
  "plugins": ["prettier-plugin-packagejson"],
  "overrides": [
    {
      "files": "*.md",
      "options": {
        "proseWrap": "never",
        "embeddedLanguageFormatting": "auto"
      }
    }
  ]
}
